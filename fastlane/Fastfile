default_platform(:ios)

# ─── Shared config ────────────────────────────────────────────────────────────
APP_IDENTIFIER       = "com.lukeristudio.kuryem"   # iOS bundle id
ANDROID_PACKAGE_NAME = "com.kuryem.lukeristudio"   # Play Console package
KEY_ID          = "T59225Z293"
ISSUER_ID       = "0a244648-8b59-4018-814c-94e07db5f262"
KEY_PATH        = File.expand_path("../keys/AuthKey_T59225Z293.p8", __dir__)
PLAY_JSON_KEY   = File.expand_path("../keys/google-play.json", __dir__)
SCREENSHOTS_DIR     = File.expand_path("./screenshots", __dir__)
IOS_METADATA_DIR    = File.expand_path("./metadata/default", __dir__)
METADATA_DIR        = File.expand_path("./metadata/android", __dir__)

# ─── App Store ────────────────────────────────────────────────────────────────
platform :ios do
  desc "Build IPA and upload to App Store Connect"
  lane :deploy do
    api_key = app_store_connect_api_key(
      key_id:       KEY_ID,
      issuer_id:    ISSUER_ID,
      key_filepath: KEY_PATH,
      duration:     1200,
      in_house:     false,
    )

    get_certificates
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
    )

    build_app(
      workspace:      "ios/Runner.xcworkspace",
      scheme:         "Runner",
      configuration:  "Release",
      export_method:  "app-store",
      output_directory: "build/ios/ipa",
    )

    deliver(
      api_key:                 api_key,
      app_identifier:          APP_IDENTIFIER,
      ipa:                     "build/ios/ipa/Runner.ipa",
      skip_metadata:           true,
      skip_screenshots:        true,
      run_precheck_before_submit: false,
      submit_for_review:       false,
      automatic_release:       false,
      force:                   true,
    )
  end

  desc "Upload screenshots to App Store Connect"
  desc "Upload screenshots and metadata to App Store Connect"
  lane :upload_screenshots do
    api_key = app_store_connect_api_key(
      key_id:       KEY_ID,
      issuer_id:    ISSUER_ID,
      key_filepath: KEY_PATH,
      duration:     1200,
      in_house:     false,
    )

    deliver(
      api_key:                 api_key,
      app_identifier:          APP_IDENTIFIER,
      screenshots_path:        "fastlane/screenshots",
      metadata_path:           "fastlane/metadata",
      skip_binary_upload:      true,
      skip_metadata:           false,
      skip_app_version_update: false,
      overwrite_screenshots:   true,
      submit_for_review:             false,
      force:                         true,
      run_precheck_before_submit:    false,
    )
  end
end

# ─── Google Play ──────────────────────────────────────────────────────────────
platform :android do
  desc "Upload screenshots to Google Play Store"
  lane :upload_screenshots do
    supply(
      package_name:             ANDROID_PACKAGE_NAME,
      json_key:                 PLAY_JSON_KEY,
      metadata_path:            METADATA_DIR,
      skip_upload_apk:          true,
      skip_upload_aab:          true,
      skip_upload_metadata:     true,
      skip_upload_changelogs:   true,
      skip_upload_images:       false,
      skip_upload_screenshots:  false,
      sync_image_upload:        true,
    )
  end

  desc "Upload AAB to Google Play Production"
  lane :deploy do
    supply(
      package_name:            ANDROID_PACKAGE_NAME,
      json_key:                PLAY_JSON_KEY,
      aab:                     File.expand_path("../build/app/outputs/bundle/release/app-release.aab", __dir__),
      track:                   "production",
      release_status:          "draft",
      skip_upload_apk:         true,
      skip_upload_metadata:    true,
      skip_upload_changelogs:  true,
      skip_upload_images:      true,
      skip_upload_screenshots: true,
    )
  end
end
